# SnkGameHost.cmake - a shipping game executable with its game module compiled in (#592, DISTRIBUTION.md).
#
#   snk_add_game_host(<target> MODULE <module target> NAME <module name>)
#
# <module target> is an OBJECT library (a static archive would drop the translation unit nobody references) whose
# sources hold the game module and its SNK_DECLARE_MODULE. It is compiled with SNK_GAME_MODULE_STATIC, so the macro
# exports nothing and defines snk_static_module_entry() instead, and with SNK_GAME_MODULE_NAME="<module name>": the
# name the project's manifest gives the module, which its name() must return. The executable's main() is generated and
# runs snk::game_host::run with that one module. Needs only the target snk::game_host, so it works in-tree and from
# the SDK alike.
function(snk_add_game_host target)
	cmake_parse_arguments(PARSE_ARGV 1 _arg "" "MODULE;NAME" "")
	if(NOT _arg_MODULE OR NOT _arg_NAME)
		message(FATAL_ERROR "snk_add_game_host(${target}): MODULE and NAME are required")
	endif()
	if(_arg_UNPARSED_ARGUMENTS)
		message(FATAL_ERROR "snk_add_game_host(${target}): unexpected arguments: ${_arg_UNPARSED_ARGUMENTS}")
	endif()
	if(NOT TARGET snk::game_host)
		message(FATAL_ERROR "snk_add_game_host(${target}): snk::game_host is not available (static engine only)")
	endif()
	if(NOT TARGET ${_arg_MODULE})
		message(FATAL_ERROR "snk_add_game_host(${target}): '${_arg_MODULE}' is not a target")
	endif()
	get_target_property(_type ${_arg_MODULE} TYPE)
	if(NOT _type STREQUAL "OBJECT_LIBRARY")
		message(FATAL_ERROR "snk_add_game_host(${target}): '${_arg_MODULE}' must be an OBJECT library, not ${_type}")
	endif()
	if(NOT _arg_NAME MATCHES "^[A-Za-z][A-Za-z0-9_-]*$")
		message(FATAL_ERROR "snk_add_game_host(${target}): '${_arg_NAME}' is not a module name")
	endif()

	target_compile_definitions(${_arg_MODULE} PRIVATE SNK_GAME_MODULE_STATIC "SNK_GAME_MODULE_NAME=\"${_arg_NAME}\"")
	target_link_libraries(${_arg_MODULE} PRIVATE snk::game_host)

	set(_main "${CMAKE_CURRENT_BINARY_DIR}/${target}_main.cpp")
	file(GENERATE OUTPUT "${_main}" CONTENT "// Generated by snk_add_game_host (cmake/SnkGameHost.cmake): do not edit.
#include <snk/game_host/game_host.h>

int main(int argc, char* argv[])
{
	return snk::game_host::run(argc, argv, { { \"${_arg_NAME}\", snk_static_module_entry() } });
}
")
	add_executable(${target} "${_main}")
	target_link_libraries(${target} PRIVATE snk::game_host PRIVATE ${_arg_MODULE})
	if(TARGET snk::sanitizers)
		target_link_libraries(${target} PRIVATE snk::sanitizers)
	endif()
endfunction()
