# SnkEngineCopies.cmake - one copy of each engine component per process when the engine is a shared library (#874).
#
# snk_engine links the engine components whole (core/engine/CMakeLists.txt, SNK_ENGINE_CARRIED). A binary that links
# snk_engine and also one of those archives gets a second copy of its code and globals. On ELF the engine's calls then
# bind to the binary's copy: desc_resave linked snk::config_system, so the engine's cfg::variable globals registered
# into the binary's registry, which was gone when they unregistered at exit (SIGSEGV). Consumers take the components'
# headers only (snk::engine_api, snk_usage_only()).

# Targets `tgt` links: its link interface, and LINK_LIBRARIES for a target that is linked. $<COMPILE_ONLY:x> is headers
# only and is left out.
function(_snk_copies_link_deps out tgt)
	get_target_property(_type ${tgt} TYPE)
	set(_items "")
	get_target_property(_iface ${tgt} INTERFACE_LINK_LIBRARIES)
	if(_iface)
		list(APPEND _items ${_iface})
	endif()
	if(_type MATCHES "^(STATIC_LIBRARY|SHARED_LIBRARY|MODULE_LIBRARY|OBJECT_LIBRARY|EXECUTABLE)$")
		get_target_property(_priv ${tgt} LINK_LIBRARIES)
		if(_priv)
			list(APPEND _items ${_priv})
		endif()
	endif()
	set(_res "")
	foreach(_item IN LISTS _items)
		if(_item MATCHES "^\\$<COMPILE_ONLY:")
			continue()
		endif()
		string(REGEX REPLACE "\\$<[A-Z_]+:|>" " " _item "${_item}")
		string(REGEX MATCHALL "[A-Za-z0-9_.+:-]+" _tokens "${_item}")
		foreach(_tok IN LISTS _tokens)
			if(TARGET ${_tok})
				get_target_property(_real ${_tok} ALIASED_TARGET)
				if(_real)
					set(_tok ${_real})
				endif()
				list(APPEND _res ${_tok})
			endif()
		endforeach()
	endforeach()
	set(${out} "${_res}" PARENT_SCOPE)
endfunction()

# Call once, after the last add_subdirectory().
function(snk_check_engine_copies)
	if(NOT SNK_ENGINE_SHARED OR NOT TARGET snk_engine)
		return()
	endif()
	get_property(_carried_names GLOBAL PROPERTY SNK_ENGINE_CARRIED)
	set(_carried "")
	foreach(_c IN LISTS _carried_names)
		get_target_property(_real ${_c} ALIASED_TARGET)
		if(_real)
			list(APPEND _carried ${_real})
		else()
			list(APPEND _carried ${_c})
		endif()
	endforeach()

	# Binaries of this source tree (third-party trees and FetchContent sources are not ours to check).
	set(_roots "")
	set(_todo "${CMAKE_SOURCE_DIR}")
	while(_todo)
		list(POP_FRONT _todo _dir)
		string(FIND "${_dir}/" "${CMAKE_SOURCE_DIR}/lib3dparty/" _in_3p)
		string(FIND "${_dir}/" "${CMAKE_SOURCE_DIR}/" _in_tree)
		if(_in_3p EQUAL 0 OR NOT _in_tree EQUAL 0)
			continue()
		endif()
		get_property(_subdirs DIRECTORY "${_dir}" PROPERTY SUBDIRECTORIES)
		list(APPEND _todo ${_subdirs})
		get_property(_targets DIRECTORY "${_dir}" PROPERTY BUILDSYSTEM_TARGETS)
		foreach(_t IN LISTS _targets)
			get_target_property(_type ${_t} TYPE)
			if(_type MATCHES "^(EXECUTABLE|SHARED_LIBRARY|MODULE_LIBRARY)$" AND NOT _t STREQUAL "snk_engine")
				list(APPEND _roots ${_t})
			endif()
		endforeach()
	endwhile()

	# Static and interface libraries are linked into the binary; a shared library is a binary of its own (its
	# dependencies are its own check).
	set(_found "")
	foreach(_root IN LISTS _roots)
		set(_seen ${_root})
		set(_queue ${_root})
		set(_links_engine FALSE)
		set(_copies "")
		set(_keys "")
		while(_queue)
			list(POP_FRONT _queue _name)
			_snk_copies_link_deps(_deps ${_name})
			foreach(_dep IN LISTS _deps)
				if(_dep IN_LIST _seen)
					continue()
				endif()
				list(APPEND _seen ${_dep})
				# Target names may hold "::", which a variable reference cannot.
				string(MAKE_C_IDENTIFIER "${_dep}" _key)
				set(_parent_${_key} ${_name})
				list(APPEND _keys ${_key})
				if(_dep STREQUAL "snk_engine")
					set(_links_engine TRUE)
					continue()
				endif()
				if(_dep IN_LIST _carried)
					list(APPEND _copies ${_dep})
				endif()
				get_target_property(_type ${_dep} TYPE)
				if(_type MATCHES "^(STATIC_LIBRARY|INTERFACE_LIBRARY|OBJECT_LIBRARY)$")
					list(APPEND _queue ${_dep})
				endif()
			endforeach()
		endwhile()
		if(NOT _links_engine)
			set(_copies "")
		endif()
		foreach(_copy IN LISTS _copies)
			set(_path ${_copy})
			set(_at ${_copy})
			string(MAKE_C_IDENTIFIER "${_at}" _key)
			while(DEFINED _parent_${_key})
				set(_at ${_parent_${_key}})
				list(PREPEND _path ${_at})
				string(MAKE_C_IDENTIFIER "${_at}" _key)
			endwhile()
			list(JOIN _path " -> " _path_text)
			list(APPEND _found "  ${_root} links ${_copy}, which snk_engine already carries: ${_path_text}")
		endforeach()
		foreach(_key IN LISTS _keys)
			unset(_parent_${_key})
		endforeach()
	endforeach()
	if(_found)
		list(JOIN _found "\n" _found_text)
		message(FATAL_ERROR "A binary that links the shared engine must not link an engine component again (a second "
			"copy of its globals, #874):\n${_found_text}\nTake the component's headers only: snk::engine_api or "
			"snk_usage_only() (cmake/SnkTarget.cmake).")
	endif()
endfunction()
