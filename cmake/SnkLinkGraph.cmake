# SnkLinkGraph.cmake - what the entries of a target's link libraries name, for the checks on the CMake link graph
# (SnkMcpIsolation.cmake, SnkEngineCopies.cmake). tools/ci/test_link_graph.cmake tests it.
include_guard(GLOBAL)

# Names in `item`, one LINK_LIBRARIES or INTERFACE_LINK_LIBRARIES entry: a plain name, the value of a wrapper
# ($<LINK_ONLY:x>) and of a conditional expression ($<$<CONFIG:Debug>:x> names x). LINKED: only what is linked, so a
# $<COMPILE_ONLY:...> part names nothing wherever it is nested (a static library writes its PRIVATE one to its
# interface as $<LINK_ONLY:$<COMPILE_ONLY:x>>). Not every name is a target: the caller asks TARGET.
function(snk_link_item_names out item)
	cmake_parse_arguments(PARSE_ARGV 2 _arg "LINKED" "" "")
	if(_arg_LINKED)
		while(TRUE)
			string(FIND "${item}" "$<COMPILE_ONLY:" _at)
			if(_at EQUAL -1)
				break()
			endif()
			string(LENGTH "${item}" _len)
			set(_depth 0)
			set(_i ${_at})
			set(_end ${_len})
			while(_i LESS _len)
				string(SUBSTRING "${item}" ${_i} 2 _two)
				if(_two STREQUAL "$<")
					math(EXPR _depth "${_depth} + 1")
					math(EXPR _i "${_i} + 2")
					continue()
				endif()
				string(SUBSTRING "${item}" ${_i} 1 _one)
				if(_one STREQUAL ">")
					math(EXPR _depth "${_depth} - 1")
					if(_depth EQUAL 0)
						math(EXPR _end "${_i} + 1")
						break()
					endif()
				endif()
				math(EXPR _i "${_i} + 1")
			endwhile()
			string(SUBSTRING "${item}" 0 ${_at} _before)
			string(SUBSTRING "${item}" ${_end} -1 _after)
			set(item "${_before}${_after}")
		endwhile()
	endif()
	# A name is words joined by "::"; a lone ":" (the end of a condition) is not part of it.
	string(REGEX MATCHALL "[A-Za-z0-9_.+-]+(::[A-Za-z0-9_.+-]+)*" _names "${item}")
	set(${out} "${_names}" PARENT_SCOPE)
endfunction()

# Targets `tgt` reaches in one step, aliases resolved: its link interface, and LINK_LIBRARIES for a target that is
# linked. LINKED: as snk_link_item_names.
function(snk_link_deps out tgt)
	cmake_parse_arguments(PARSE_ARGV 2 _arg "LINKED" "" "")
	get_target_property(_type ${tgt} TYPE)
	set(_items "")
	get_target_property(_iface ${tgt} INTERFACE_LINK_LIBRARIES)
	if(_iface)
		list(APPEND _items ${_iface})
	endif()
	if(_type MATCHES "^(STATIC_LIBRARY|SHARED_LIBRARY|MODULE_LIBRARY|OBJECT_LIBRARY|EXECUTABLE)$")
		get_target_property(_priv ${tgt} LINK_LIBRARIES)
		if(_priv)
			list(APPEND _items ${_priv})
		endif()
	endif()
	set(_mode "")
	if(_arg_LINKED)
		set(_mode LINKED)
	endif()
	set(_res "")
	foreach(_item IN LISTS _items)
		snk_link_item_names(_names "${_item}" ${_mode})
		foreach(_name IN LISTS _names)
			if(TARGET ${_name})
				get_target_property(_real ${_name} ALIASED_TARGET)
				if(_real)
					set(_name ${_real})
				endif()
				list(APPEND _res ${_name})
			endif()
		endforeach()
	endforeach()
	set(${out} "${_res}" PARENT_SCOPE)
endfunction()
