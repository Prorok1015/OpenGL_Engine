# cmake -P tools/ci/test_link_graph.cmake - the link graph checks (#874): what a link entry names
# (cmake/SnkLinkGraph.cmake), and snk_check_engine_copies() (cmake/SnkEngineCopies.cmake) on a toy project.
include("${CMAKE_CURRENT_LIST_DIR}/../../cmake/SnkLinkGraph.cmake")

function(expect_names item mode expected)
	snk_link_item_names(_names "${item}" ${mode})
	if(NOT "${_names}" STREQUAL "${expected}")
		message(FATAL_ERROR "snk_link_item_names('${item}' ${mode}): expected '${expected}', got '${_names}'")
	endif()
endfunction()

expect_names("snk::config_system" "" "snk::config_system")
expect_names("$<LINK_ONLY:snk::config_system>" LINKED "LINK_ONLY;snk::config_system")
expect_names("$<COMPILE_ONLY:snk::config_system>" LINKED "")
expect_names("$<LINK_ONLY:$<COMPILE_ONLY:snk::config_system>>" LINKED "LINK_ONLY")
expect_names("$<COMPILE_ONLY:snk::config_system>" "" "COMPILE_ONLY;snk::config_system")
expect_names("$<$<CONFIG:Debug>:snk::config_system>" LINKED "CONFIG;Debug;snk::config_system")
expect_names("$<BUILD_LOCAL_INTERFACE:$<COMPILE_ONLY:a>>" LINKED "BUILD_LOCAL_INTERFACE")
expect_names("$<LINK_ONLY:$<COMPILE_ONLY:$<$<CONFIG:Debug>:a>>>" LINKED "LINK_ONLY")
message(STATUS "snk_link_item_names: all cases pass")

set(_toy "${CMAKE_CURRENT_LIST_DIR}/engine_copies_toy")
get_filename_component(_root "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
if(DEFINED ENV{RUNNER_TEMP})
	set(_work "$ENV{RUNNER_TEMP}/engine_copies_toy")
else()
	set(_work "${CMAKE_CURRENT_BINARY_DIR}/engine_copies_toy")
endif()

function(expect_check case fragment)
	file(REMOVE_RECURSE "${_work}/${case}")
	execute_process(COMMAND "${CMAKE_COMMAND}" -S "${_toy}" -B "${_work}/${case}" -DCASE=${case} "-DSNK_ROOT=${_root}"
		RESULT_VARIABLE _rc OUTPUT_VARIABLE _out ERROR_VARIABLE _err)
	if(fragment STREQUAL "")
		if(NOT _rc EQUAL 0)
			message(FATAL_ERROR "snk_check_engine_copies, ${case}: expected to pass, got:\n${_out}\n${_err}")
		endif()
	elseif(_rc EQUAL 0)
		message(FATAL_ERROR "snk_check_engine_copies, ${case}: expected to fail with '${fragment}', it passed")
	elseif(NOT "${_err}" MATCHES "${fragment}")
		message(FATAL_ERROR "snk_check_engine_copies, ${case}: expected '${fragment}', got:\n${_err}")
	endif()
endfunction()

expect_check(compile_only_in_static "")
expect_check(no_engine "")
expect_check(direct "tool links config_system")
expect_check(conditional "tool links config_system")
expect_check(through_static "tool -> helper -> config_system")
message(STATUS "snk_check_engine_copies: all cases pass")
