# #1109: one editor look for the owner to choose from, at --size 1920x1080 with startup_level levels/smoke_level.desc.
# @OUT@ is the run's folder, put in by build.yml (shot takes a literal path). Nothing here is compared to a reference:
# the themes move every panel, so a click may land beside its target, which only shows in the picture.
sleep 18
shot @OUT@/1_overview.png
# Directional light in the Hierarchy: selection highlight and the Inspector
click_item hierarchy Directional Light
sleep 1
shot @OUT@/2_selection.png
# The Console in front of the Problems tab it shares (#1136: its lines are in the mono face): View > Console closes it
# and opens it again, and a tab that comes back into its dock node is the one shown. By name: needs editor/ui_probe.
click_item menu View
sleep 1
click_item menu Console
sleep 1
click_item menu View
sleep 1
click_item menu Console
sleep 2
shot @OUT@/2b_console.png
# File menu
click 19 10
sleep 1
shot @OUT@/3_file_menu.png
key Escape
sleep 1
# Save Level As: the file dialog
key ctrl+shift+s
sleep 2
shot @OUT@/4_save_dialog.png
