# Checklist items 1-5 at --size 1920x1080 with startup_level levels/smoke_level.desc
# Zoom out one step (wheel down + tiny drag as a workaround for the wheel-down refresh bug), select Armature.
# Hierarchy rows and the Bones button are found by name (#1130, editor/ui_probe); the viewport is clicked at a point.
sleep 18
click 960 400 5
sleep 0.3
drag 960 400 961 400
sleep 1
click_item hierarchy_toggle scene
sleep 0.5
click_item hierarchy_toggle Armature
sleep 0.5
click_item hierarchy Armature
sleep 1
shot headless_out/checklist/10_anim_t0.png
sleep 2
shot headless_out/checklist/10_anim_t1.png
sleep 2
shot headless_out/checklist/10_anim_t2.png
# Bones toggle on
click_item viewport_toolbar Bones
sleep 2
shot headless_out/checklist/11_bones_on.png
click_item viewport_toolbar Bones
sleep 1
# Directional light: select and inspect
click_item hierarchy Directional Light
sleep 1
shot headless_out/checklist/12_light_sel.png
# End where tools/headless/reference/checklist.png is: scene collapsed, Game Camera selected. That image was taken
# with the old fixed-point clicks, which hit these rows (and Wireframe instead of Bones) in the classic layout (#1130).
click_item hierarchy_toggle scene
sleep 0.5
click_item hierarchy Game Camera
sleep 1
