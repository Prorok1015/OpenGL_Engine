# #419: drag an asset from the Asset Browser onto the viewport. The asset is found by name (#646: the editor logs the
# rectangle of every entry with editor/ui_probe), so a new folder or file in the sandbox's res:// root does not move it;
# the viewport centre of the 1920x1080 checklist run with startup_level levels/smoke_level.desc is (960,400). Any dropped
# asset is added through its desc: the editor logs "Added 'base_material' to scene".
sleep 1
shot headless_out/drag_drop/00_start.png
drag_item asset_browser base_material.desc 960 400
sleep 3
shot headless_out/drag_drop/01_after_drop.png
