{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 24, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "SNK_COMPILER_CACHE": "AUTO",
        "SNK_PCH": "AUTO",
        "SNK_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "dev-debug",
      "inherits": "base",
      "displayName": "Dev Debug",
      "description": "Debug build with the internal profiler enabled",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ENGINE_PROFILE_MODE": "INTERNAL"
      }
    },
    {
      "name": "dev-release",
      "inherits": "base",
      "displayName": "Dev RelWithDebInfo",
      "description": "Optimized build with debug info and the internal profiler",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "ENGINE_PROFILE_MODE": "INTERNAL"
      }
    },
    {
      "name": "release",
      "inherits": "base",
      "displayName": "Release",
      "description": "Optimized build, profiler disabled, all Assimp formats",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ENGINE_PROFILE_MODE": "NONE",
        "SNK_ASSIMP_FORMATS": "ALL"
      }
    },
    {
      "name": "no-assimp",
      "inherits": "dev-debug",
      "displayName": "Dev Debug (no Assimp importer)",
      "description": "Debug build without the Assimp importer (SNK_WITH_ASSIMP=OFF): assimp is not configured, the model importer and the editor model import are not compiled",
      "cacheVariables": {
        "SNK_WITH_ASSIMP": "OFF"
      }
    },

    {
      "name": "ci",
      "hidden": true,
      "inherits": "base",
      "description": "Common CI settings (.github/workflows). Compiler cache and PCH come from base.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ENGINE_PROFILE_MODE": "INTERNAL"
      }
    },
    {
      "name": "ci-linux",
      "hidden": true,
      "inherits": "ci",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "cacheVariables": {
        "GLFW_BUILD_WAYLAND": "OFF",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "ci-linux-gcc-debug",
      "inherits": "ci-linux",
      "displayName": "CI Linux GCC Debug"
    },
    {
      "name": "ci-linux-gcc-release",
      "inherits": "ci-linux",
      "displayName": "CI Linux GCC Release (benchmarks)",
      "description": "Optimized build with the internal profiler: the extract benchmark (unit_tests AppEngineNullBackendBench)",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "ci-linux-clang-debug",
      "inherits": "ci-linux",
      "displayName": "CI Linux Clang Debug (PCH off)",
      "description": "PCH is off on purpose: this job catches headers that only compile thanks to the PCH",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "SNK_PCH": "OFF"
      }
    },
    {
      "name": "ci-linux-no-assimp",
      "inherits": "ci-linux",
      "displayName": "CI Linux GCC without Assimp",
      "description": "SNK_WITH_ASSIMP=OFF: the model importer and the editor model import are not compiled",
      "cacheVariables": { "SNK_WITH_ASSIMP": "OFF" }
    },
    {
      "name": "ci-linux-asan",
      "inherits": "ci-linux",
      "displayName": "CI Linux ASan+UBSan",
      "cacheVariables": { "SNK_SANITIZE": "address" }
    },
    {
      "name": "ci-linux-tsan",
      "inherits": "ci-linux",
      "displayName": "CI Linux TSan",
      "cacheVariables": { "SNK_SANITIZE": "thread" }
    },
    {
      "name": "ci-linux-coverage",
      "inherits": "ci-linux",
      "displayName": "CI Linux GCC coverage",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "--coverage",
        "CMAKE_EXE_LINKER_FLAGS": "--coverage"
      }
    },
    {
      "name": "ci-linux-shared",
      "inherits": "ci-linux",
      "displayName": "CI Linux GCC shared snk_engine",
      "description": "Needs CMake 3.27+",
      "cacheVariables": { "SNK_ENGINE_SHARED": "ON" }
    },
    {
      "name": "ci-windows-msvc-debug",
      "inherits": "ci",
      "displayName": "CI Windows MSVC Debug",
      "description": "Run from a Developer Command Prompt (cl.exe on PATH)",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "ci-windows-msvc-shared",
      "inherits": "ci-windows-msvc-debug",
      "displayName": "CI Windows MSVC shared snk_engine",
      "description": "Needs CMake 3.27+",
      "cacheVariables": { "SNK_ENGINE_SHARED": "ON" }
    },
    {
      "name": "ci-windows-msvc-release",
      "inherits": "ci-windows-msvc-debug",
      "displayName": "CI Windows MSVC Release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ENGINE_PROFILE_MODE": "NONE"
      }
    },
    {
      "name": "ci-windows-msvc-shared-release",
      "inherits": "ci-windows-msvc-release",
      "displayName": "CI Windows MSVC Release shared snk_engine",
      "description": "Needs CMake 3.27+",
      "cacheVariables": { "SNK_ENGINE_SHARED": "ON" }
    }
  ],
  "buildPresets": [
    { "name": "build-debug", "configurePreset": "dev-debug" },
    { "name": "build-release", "configurePreset": "release" }
  ]
}
